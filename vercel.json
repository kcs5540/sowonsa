{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/save-consultation.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/save-consultation",
      "dest": "api/save-consultation.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

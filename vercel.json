    {
      "src": "sowonsa-plan.html",
      "use": "@vercel/static"
    },
    {
      "src": "partner-guide.html",
      "use": "@vercel/static"
    },
    {
      "src": "sowonsa-guide.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
